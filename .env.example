# docker compose için. Kopyala: cp .env.example .env
# JWT imzalama anahtarı, en az 32 karakter. Üret: openssl rand -base64 48
JWT_KEY=
POSTGRES_PASSWORD=trustnobody
# Makinede 5432 doluysa değiştir
DB_PORT=5432
WEB_PORT=8080
# API başka bir domain'deyse doldur (ör. https://api.example.com). Boş = aynı origin.
PUBLIC_API_URL=
