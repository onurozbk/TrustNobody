# nginx imajı açılışta bu şablondaki ${API_UPSTREAM} değerini ortam değişkeniyle doldurur
# (/etc/nginx/templates → /etc/nginx/conf.d). Diğer $değişkenler nginx'in kendisine aittir, dokunulmaz.
#   docker compose: API_UPSTREAM=http://api:8080 (Dockerfile varsayılanı)
#   k3s:            API_UPSTREAM=http://trustnobody-api (deploy/k8s/web.yaml)
#                   Orada /api ve /hubs zaten Ingress'ten doğrudan API'ye gider.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Kubernetes probe'ları için hafif sağlık ucu
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # API ve SignalR aynı origin'den: CORS gerekmez
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hubs/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # Dosya adında hash olan derleme çıktıları uzun süre önbelleğe alınabilir
    location /_expo/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: /join/ABC123 gibi tüm yollar index.html'e düşer, yönlendirmeyi expo-router yapar
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
